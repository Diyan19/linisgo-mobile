# LinisGo Finder — Private REST API Environment Configuration (Task 1.2B Stage 1)
# Copy this file to api/.env for local development. Never commit real secrets or private keys.
#
# Recommended Local Authentication (Keyless ADC with Service-Account Impersonation):
#   gcloud config set project linisgo-mobile
#   gcloud auth application-default login --impersonate-service-account=linisgo-backend-dev@linisgo-mobile.iam.gserviceaccount.com

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
FIREBASE_PROJECT_ID=linisgo-mobile
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_LOCATION=nam5
FIRESTORE_EDITION=Standard
FIRESTORE_MODE=Firestore Native
FIREBASE_WEB_API_KEY=
ALLOWED_ORIGINS=https://ais-dev-wjmg4lrpgdcyxp2jlqp5km-332623356276.asia-east1.run.app,https://ais-pre-wjmg4lrpgdcyxp2jlqp5km-332623356276.asia-east1.run.app,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUEST=100
